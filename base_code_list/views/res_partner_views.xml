<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Codes">
                    <group>
                        <field
                            name="code_list_item_ids"
                            widget="many2many_tags"
                            readonly="1"
                            context="{'include_list_code': True}"
                        />
                    </group>
                    <field name="code_list_usage_ids" context="{'default_model': 'res.partner', 'default_res_id': id}">
                        <list editable="bottom">
                            <field name="model" column_invisible="1"/>
                            <field name="res_id" column_invisible="1"/>
                            <field name="code_list_id"/>
                            <field name="code_list_item_id" domain="[('list_id', '=', code_list_id)]"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
