<odoo>
    <record id="code_list_item_view_form" model="ir.ui.view">
        <field name="model">code.list.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group name="main">
                        <group name="general">
                            <field name="code" />
                            <field name="name" />
                            <field name="active" invisible="1" />
                        </group>
                        <group name="extra">
                            <field name="list_id" />
                        </group>
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="code_list_item_view_tree" model="ir.ui.view">
        <field name="model">code.list.item</field>
        <field name="arch" type="xml">
            <list>
                <field
                    name="list_id"
                    column_invisible="not context.get('code_list_item_main_view')"
                />
                <field name="code" />
                <field name="name" />
                <field name="description" optional="show" />
            </list>
        </field>
    </record>
    <record id="code_list_item_view_search" model="ir.ui.view">
        <field name="model">code.list.item</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Name or Code"
                    filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"
                />
                <field name="code" />
                <field name="list_id" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <group string="Group By" name="groupby">
                    <filter
                        name="list_id_groupby"
                        string="List"
                        context="{'group_by': 'list_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="code_list_item_action" model="ir.actions.act_window">
        <field name="name">Code List Items</field>
        <field name="res_model">code.list.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'code_list_item_main_view': True}</field>
    </record>
    <menuitem
        id="code_list_item_menu"
        action="code_list_item_action"
        parent="base.menu_ir_property"
        sequence="150"
    />
</odoo>
