    <record id="code_list_item_view_list" model="ir.ui.view">
        <field name="model">code.list.item</field>
        <field name="arch" type="xml">
            <list editable="bottom" >
                <field name="list_id" column_invisible="context.get('hide_list_id')" />
                <field name="code" optional="hide" />
                <field name="name" />
                <field name="description" optional="hide" />
                <field
                    name="parent_id"
                    domain="[('list_id', '=', list_id), ('child_list_id', '=', False)]"
                    optional="hide"
                />
                <field
                    name="child_ids"
                    optional="hide"
                    readonly="1"
                    widget="many2many_tags"
                />
                <field
                    name="child_list_id"
                    domain="[('id', '!=', list_id), ('id', 'not in', list_parent_ids)]"
                    optional="hide"
                    readonly="child_ids"
                />
            </list>
        </field>
    </record>
    <record id="code_list_item_view_search" model="ir.ui.view">
        <field name="model">code.list.item</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Name or Code"
                    filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"
                />
                <field name="code" />
                <field name="list_id" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <group string="Group By" name="groupby">
                    <filter
                        name="list_id_groupby"
                        string="List"
                        context="{'group_by': 'list_id'}"
                    />
                </group>
                <searchpanel>
                    <field name="parent_id" string="Parent Item"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="code_list_item_action" model="ir.actions.act_window">
        <field name="name">Code List Items</field>
        <field name="res_model">code.list.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
