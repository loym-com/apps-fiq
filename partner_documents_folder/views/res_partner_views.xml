<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.documents</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <group name="container_row_2" position="inside">
                <group name="document_folders" string="Document Folders">
                    <group string="Contact">
                        <field name="partner_folder_id" invisible="1" />
                        <field name="partner_folder_url"
                            string="External Link"
                            widget="url"
                            invisible="partner_folder_id"
                        />
                        <button name="action_goto_documents"
                                args="['partner', 'internal']"
                                type="object"
                                string="Internal"
                                icon="fa-folder-open"
                                invisible="not partner_folder_id"
                        />
                        <button name="action_goto_documents"
                                args="['partner', 'external']"
                                type="object"
                                string="External"
                                icon="fa-folder-open"
                                invisible="not partner_folder_id"
                        />
                    </group>
                    <group string="Customer">
                        <field name="customer_folder_id" invisible="1" />
                        <field name="customer_folder_url"
                            string="External Link"
                            widget="url"
                            invisible="customer_folder_id"
                        />
                        <button name="action_goto_documents"
                                args="['customer', 'internal']"
                                type="object"
                                string="Internal"
                                icon="fa-folder-open"
                                invisible="not customer_folder_id"
                        />
                        <button name="action_goto_documents"
                                args="['customer', 'external']"
                                type="object"
                                string="External"
                                icon="fa-folder-open"
                                invisible="not customer_folder_id"
                        />
                    </group>
                    <group string="Supplier">
                        <field name="supplier_folder_id" invisible="1" />
                        <field name="supplier_folder_url"
                            string="External Link"
                            widget="url"
                            invisible="supplier_folder_id"
                        />
                        SUPPLIER
                        <button name="action_goto_documents"
                                args="['supplier', 'internal']"
                                type="object"
                                string="Internal"
                                icon="fa-folder-open"
                                invisible="not supplier_folder_id"
                        />
                        <button name="action_goto_documents"
                                args="['supplier', 'external']"
                                type="object"
                                string="External"
                                icon="fa-folder-open"
                                invisible="not supplier_folder_id"
                        />
                    </group>
                </group>
            </group>
        </field>
    </record>
</data>
