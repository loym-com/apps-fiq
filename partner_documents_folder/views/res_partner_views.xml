<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.folder_url</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <data>
                <group name="misc" position="inside">
                    <field name="partner_folder_id" readonly="1" />
                    <field name="partner_folder_url" widget="url" readonly="partner_folder_id" />
                    <field name="customer_folder_id" readonly="1" />
                    <field name="customer_folder_url" widget="url" readonly="customer_folder_id" />
                    <field name="supplier_folder_id" readonly="1" />
                    <field name="supplier_folder_url" widget="url" readonly="supplier_folder_id" />
                </group>
            </data>
        </field>
    </record>
</data>
