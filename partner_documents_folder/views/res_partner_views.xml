<?xml version="1.0" encoding="utf-8" ?>
<data>
    <!-- URL actions -->
    <record id="action_goto_partner_internal_documents" model="ir.actions.act_url">
        <field name="name">Partner Documents (Internal)</field>
        <field name="url">/odoo/documents/{{object.partner_folder_id.document_token}}</field>
        <field name="target">self</field>
    </record>
    <record id="action_goto_customer_internal_documents" model="ir.actions.act_url">
        <field name="name">Customer Documents (Internal)</field>
        <field name="url">/odoo/documents/{{object.customer_folder_id.document_token}}</field>
        <field name="target">self</field>
    </record>
    <record id="action_goto_supplier_internal_documents" model="ir.actions.act_url">
        <field name="name">Supplier Documents (Internal)</field>
        <field name="url">/odoo/documents/{{object.supplier_folder_id.document_token}}</field>
        <field name="target">self</field>
    </record>
    <record id="action_goto_partner_external_documents" model="ir.actions.act_url">
        <field name="name">Partner Documents (External)</field>
        <field name="url">/odoo/{{object.partner_folder_url.raw_value}}</field>
        <field name="target">new</field>
    </record>
    <record id="action_goto_customer_external_documents" model="ir.actions.act_url">
        <field name="name">Customer Documents (External)</field>
        <field name="url">/odoo/{{object.customer_folder_url}}</field>
        <field name="target">new</field>
    </record>
    <record id="action_goto_supplier_external_documents" model="ir.actions.act_url">
        <field name="name">Supplier Documents (External)</field>
        <field name="url">{{object.supplier_folder_url}}</field>
        <field name="target">new</field>
    </record>

