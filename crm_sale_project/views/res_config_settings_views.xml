<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.crm.sale.project</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="crm_name.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='crm']" position="inside">
                    <block name="crm_sale_project" title="Create sale order and project">
                        <setting string="Product for new sale order">
                            <field
                                name="crm_sale_project__sale_order_product_id"
                                class="w-100"
                            />
                        </setting>
                        <setting string="Name for new project">
                            <field
                                name="crm_sale_project__project_name_pattern"
                                placeholder="{r.sale_order_id.name} {r.sale_order_id.opportunity_id.name}"
                                class="w-100"
                            />
                        </setting>
                    </block>
                </xpath>
                <field name="crm_lead_name_expression" position="attributes">
                    <attribute name="placeholder">{r.partner_id.short_name if r.partner_id.short_name else r.partner_id.name}{' - ' + r.project_address if r.project_address else ''}</attribute>
                </field>
                <field name="crm_lead_name_expression_triggers" position="attributes">
                    <attribute name="placeholder">partner_id, project_address</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>
