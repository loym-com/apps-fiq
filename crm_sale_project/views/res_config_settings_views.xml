<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_crm_sale_project" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.crm.sale.project</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="crm.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='crm']" position="inside">
                    <div class="app_settings_block" data-string="create-so-prj" string="Create SO &amp; PRJ">
                        <h2>Create sale order and project</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <label
                                    for="crm_sale_project__sale_order_product_id"
                                    string="Product for new sale order"
                                />
                                <field
                                    name="crm_sale_project__sale_order_product_id"
                                    class="w-100"
                                    domain="[('project_template_id', '!=', False)]"
                                />
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <label
                                    for="crm_sale_project__project_name_pattern"
                                    string="Name for new project"
                                />
                                <field
                                    name="crm_sale_project__project_name_pattern"
                                    class="w-100"
                                    placeholder="{r.sale_order_id.name} {r.sale_order_id.opportunity_id.name}"
                                />
                            </div>
                        </div>
                    </div>
                </xpath>
                <field name="crm_lead_name_pattern" position="attributes">
                    <attribute name="placeholder">{r.partner_id.short_name if r.partner_id.short_name else r.partner_id.name}{' - ' if r.project_address else ''}{r.project_address}</attribute>
                </field>
                <field name="crm_lead_name_pattern_triggers" position="attributes">
                    <attribute name="placeholder">partner_id, project_address</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>
