<odoo>
    <record id="product_template_attribute_value_view_form" model="ir.ui.view">
        <field name="name">product.template.attribute.value.view.form.inherit</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="model">product.template.attribute.value</field>
        <field name="arch" type="xml">
            <field name="price_extra" position="after">
                <field name="combi_price_ids" widget="one2many_list">
                    <list editable="bottom">
                        <field name="ptav_id" groups="stock.group_stock_user" readonly="1"  optional="hide"/>
                        <field name="ptav_tmpl_id" groups="stock.group_stock_user" readonly="1"  optional="hide"/>
                        <field
                            name="condition_ptav_id"
                            groups="stock.group_stock_user"
                            domain="[('product_tmpl_id', '=', ptav_tmpl_id), ('attribute_id', '!=', ptav_attribute_id)]"
                        />
                        <!-- <field name="price_extra_option" optional="hide"/> -->
                        <!-- <field name="price_extra" invisible="price_extra_option != 'fixed'"/> -->
                        <!-- <field name="price_extra_percent" invisible="price_extra_option != 'percent'"/> -->
                        <field name="price_extra" invisible="price_extra_percent"/>
                        <field name="price_extra_percent" invisible="price_extra" widget="percentage"/>
                    </list>
                </field>
            </field>
        </field>
    </record>
</odoo>
