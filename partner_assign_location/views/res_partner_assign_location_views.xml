<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="res_partner_assign_location_view_list" model="ir.ui.view">
        <field name="name">res.partner.assign.location.view.list</field>
        <field name="model">res.partner.assign.location</field>
        <field name="arch" type="xml">
            <list string="Partner Assign Location">
                <field name="partner_id"/>
                <field name="is_exclusive"/>
                <field name="location_field"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="res_partner_assign_location_view_form" model="ir.ui.view">
        <field name="name">res.partner.assign.location.view.form</field>
        <field name="model">res.partner.assign.location</field>
        <field name="arch" type="xml">
            <form string="Partner Assign Location">
                <sheet>
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="partner_id"/>
                        <field name="is_exclusive"/>
                        <field name="location_field"/>
                        <field name="country_id"/>
                        <field
                            name="state_id"
                            domain="[('country_id', '=', country_id)]"
                            invisible="not country_id or location_field not in ('zip_id', 'city_id', 'state_id')"
                        />
                        <field
                            name="city_id"
                            domain="[('state_id', '=', state_id)]"
                            invisible="not state_id or location_field not in ('zip_id', 'city_id')"
                        />
                        <field
                            name="zip_id"
                            domain="[('city_id', '=', city_id)]"
                            invisible="not city_id or location_field not in ('zip_id')"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="res_partner_assign_location_view_search" model="ir.ui.view">
        <field name="name">res.partner.assign.location.view.search</field>
        <field name="model">res.partner.assign.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="location_field"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="city_id"/>
                <field name="zip_id"/>
                <filter name="is_exclusive" string="Exclusive" domain="[('is_exclusive', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="res_partner_assign_location_action" model="ir.actions.act_window">
        <field name="name">Partner Assign Location</field>
        <field name="res_model">res.partner.assign.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign your first area to an agent
            </p>
        </field>
    </record>
    <menuitem
        id="res_partner_assign_location_menu"
        name="Partner Assign Location"
        sequence="90"
        parent="contacts.menu_localisation"
        action="res_partner_assign_location_action"
    />
</data>
