<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="project_role_view_list" model="ir.ui.view">
        <field name="name">project.role.view.list.inherit</field>
        <field name="model">project.role</field>
        <field name="inherit_id" ref="project_role.project_role_view_tree" />
        <field name="arch" type="xml">
            <data>
                <list position="inside">
                    <field
                        name="code_list_item_ids"
                        widget="many2many_tags"
                        readonly="1"
                        context="{'include_list_code': True}"
                        optional="hide"
                    />
                </list>
            </data>
        </field>
    </record>
    <record id="project_role_view_form" model="ir.ui.view">
        <field name="name">project.role.view.form.inherit.codes</field>
        <field name="model">project.role</field>
        <field name="inherit_id" ref="project_role.project_role_view_form" />
        <field name="arch" type="xml">
            <data>
                <sheet position="inside">
                    <notebook>
                        <page string="Codes">
                            <group>
                                <field
                                    name="code_list_item_ids"
                                    widget="many2many_tags"
                                    readonly="1"
                                    context="{'include_list_code': True}"
                                />
                            </group>
                            <field name="code_list_usage_ids" context="{'default_model': 'project.role', 'default_res_id': id}">
                                <list editable="bottom">
                                    <field name="model" column_invisible="1"/>
                                    <field name="res_id" column_invisible="1"/>
                                    <field name="code_list_id"/>
                                    <field name="code_list_item_id" domain="[('list_id', '=', code_list_id)]"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </data>
        </field>
    </record>
</data>
