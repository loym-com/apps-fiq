<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_project_properties" model="ir.actions.report">
        <field name="name">Project Properties</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vidir_project.report_project_properties_document</field>
        <field name="report_file">vidir_project.report_project_properties_document</field>
        <field name="binding_model_id" ref="project.model_project_project" />
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
        <field name="multi" eval="False" />
    </record>

    <template id="report_project_properties_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Project Properties</h2>

                        <table class="table table-sm o_main_table">
                            <tbody>
                                <tr>
                                    <th style="width: 30%;">Project Type</th>
                                    <td>
                                        <span t-esc="doc.type_id.display_name or ''" />
                                    </td>
                                </tr>
                                <tr>
                                    <th>Project Name</th>
                                    <td>
                                        <span t-esc="doc.name" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Properties</h3>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th style="width: 20%;">Code</th>
                                    <th style="width: 30%;">Label</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="report_properties" t-value="doc._get_report_properties()" />
                                <tr t-foreach="report_properties" t-as="prop">
                                    <td>
                                        <span t-esc="prop.get('code')" />
                                    </td>
                                    <td>
                                        <span t-esc="prop.get('label')" />
                                    </td>
                                    <td>
                                        <span t-esc="prop.get('value')" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
