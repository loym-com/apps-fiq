<odoo>
    <record id="documents_document_view_list" model="ir.ui.view">
        <field name="name">documents.document.view.list.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <button name="action_document_form" type="object" icon="fa-info-circle" title="View Document Form"/>
                <button
                    name="open_resource"
                    type="object"
                    icon="fa-external-link"
                    title="View Related Resource"
                    invisible="not (res_model and res_id)"
                />
            </list>
        </field>
    </record>
    <record id="documents_document_view_kanban" model="ir.ui.view">
        <field name="name">documents.document.view.kanban.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_kanban"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//templates/t/div/div[2]/div[1]/field[@name='is_favorited']" position="after">
                    <button name="action_document_form" type="object" icon="fa-info-circle" title="View Document Form"/>
                    <button
                        name="open_resource"
                        type="object"
                        icon="fa-external-link"
                        title="View Related Resource"
                        invisible="not (res_model and res_id)"
                    />
                </xpath>
                <field name="activity_ids" position="after">
                    <button name="action_document_form" type="object" icon="fa-info-circle" title="View Document Form"/>
                    <button
                        name="open_resource"
                        type="object"
                        icon="fa-external-link"
                        title="View Related Resource"
                        invisible="not (res_model and res_id)"
                    />
                </field>
            </data>
        </field>
    </record>
    <record id="documents_document_view_form" model="ir.ui.view">
        <field name="name">documents.document.view.form.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_form"/>
        <field name="arch" type="xml">
            <data>
                <sheet position="inside">
                    <group>
                        <field name="access_internal" readonly="1"/>
                        <field name="access_ids" readonly="1"/>
                    </group>
                </sheet>
                <field name="folder_id" position="attributes">
                    <attribute name="widget">many2one</attribute>
                </field>
            </data>
        </field>
    </record>
</odoo>
