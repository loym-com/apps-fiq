<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="product_product_view_form" model="ir.ui.view">
        <field name="name">product.product.view.form.inherit.product_documents_tag</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <data>
                <group name="group_general" position="inside">
                    <field name="documents_tag_id" />
                    <field name="documents_tag_tooltip_translate" />
                    <field name="documents_tag_ids_filter" widget="boolean_toggle" />
                    <field
                        name="documents_tag_ids"
                        invisible="documents_tag_ids_filter"
                        widget="many2many_tags"
                        options="{'no_quick_create': True}"
                    />
                    <field
                        name="documents_tag_ids"
                        domain="[('id', 'child_of', documents_tag_id)]"
                        invisible="not documents_tag_ids_filter"
                        widget="many2many_tags"
                        options="{'no_quick_create': True}"
                    />
                </group>
            </data>
        </field>
    </record>
</data>
