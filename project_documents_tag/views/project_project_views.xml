<?xml version="1.0" encoding="utf-8" ?>
<data>
    <record id="project_project_view_form" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.project_documents_tag</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="documents_project.edit_project_document_form_inherit" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//setting[@id='documents_setting']/div/div[div/field[@name='documents_tag_ids']]" position="before">
                    <div class="row align-items-center mb-2">
                        <div class="col-auto pe-2">
                            <label for="documents_tag_id" class="fw-bold mb-0">Default Main Tag</label>
                        </div>
                        <div class="col">
                            <field name="documents_tag_id" class="w-100"/>
                        </div>
                    </div>
                    <div class="row align-items-center mb-2">
                        <div class="col-auto pe-2">
                            <label for="documents_tag_ids_filter" class="fw-bold mb-0">Filter by Main Tag</label>
                        </div>
                        <div class="col">
                            <field name="documents_tag_ids_filter" widget="boolean_toggle" class="w-100"/>
                        </div>
                    </div>
                </xpath>
                <field name="documents_tag_ids" position="attributes">
                    <attribute name="invisible">documents_tag_ids_filter</attribute>
                </field>
                <field name="documents_tag_ids" position="after">
                    <field
                        name="documents_tag_ids"
                        domain="[('id', 'child_of', documents_tag_id)]"
                        invisible="not documents_tag_ids_filter"
                        widget="many2many_tags"
                        class="ps-3 w-100"
                        options="{'no_quick_create': True}"
                        context="{'documents_project_folder': documents_folder_id}"
                    />
                </field>
            </data>
        </field>
    </record>
    <record id="project_project_view_list" model="ir.ui.view">
        <field name="name">project.project.view.list.inherit.project_documents_tag</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="documents_tag_id" optional="hide" />
                <field name="documents_tag_ids" optional="hide" />
            </field>
        </field>
    </record>
