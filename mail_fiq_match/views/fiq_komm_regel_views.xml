<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiq_komm_regel_list" model="ir.ui.view">
        <field name="name">fiq.komm.regel.list</field>
        <field name="model">fiq.komm.regel</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="condition_type"/>
                <field name="condition_value"/>
                <field name="target_type"/>
                <field name="target_project_id"
                       column_invisible="context.get('hide_project')"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_fiq_komm_regel_form" model="ir.ui.view">
        <field name="name">fiq.komm.regel.form</field>
        <field name="model">fiq.komm.regel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="When">
                        <field name="condition_type"/>
                        <field name="condition_value"/>
                    </group>
                    <group string="Then suggest">
                        <field name="target_type"/>
                        <field name="target_project_id"
                               invisible="target_type != 'project'"
                               required="target_type == 'project'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fiq_komm_regel" model="ir.actions.act_window">
        <field name="name">Communication rules</field>
        <field name="res_model">fiq.komm.regel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first communication rule</p>
            <p>Tell the system, in plain words, which element an incoming message
               belongs to — e.g. "IF sender domain is lysglint.no THEN the sender's open items".</p>
        </field>
    </record>

    <menuitem id="menu_fiq_komm_regel"
              name="Communication rules"
              parent="base.menu_administration"
              action="action_fiq_komm_regel"
              sequence="90"/>
</odoo>
